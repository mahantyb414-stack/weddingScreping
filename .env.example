# Copy this file to .env and fill in your values.
# Never commit .env to Git.

DATABASE_URL=postgresql://user:password@host:5432/dbname

# Batch / concurrency (keep low for 512 MB Render instance)
SCRAPER_BATCH_SIZE=5
MAX_LOCATION_ATTEMPTS=3
LOCATION_WORKERS=1
CTX_POOL_SIZE=1
DETAIL_WORKERS=1
MAX_RESULTS=30

# Which category to scrape (must match a matchers/<category>.yaml file)
SCRAPER_CATEGORY=mehendi_artist
SCRAPER_STATE=Jharkhand

# Stale-running recovery
STALE_RUNNING_MINUTES=30
SCRAPE_LEASE_TIMEOUT_MINUTES=20

# API server
PORT=10000

# Protect POST /scrape/start — set a strong random string
SCRAPE_TRIGGER_TOKEN=change-me-to-a-strong-secret

# Max wall-clock minutes per triggered batch before the worker stops cleanly
MAX_RUNTIME_MINUTES=12
